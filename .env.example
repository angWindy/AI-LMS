# Database Configuration
DB_USER=lms_user
DB_PASSWORD=lms_password
DB_NAME=lms_db
DB_PORT=5432

# Backend Network
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Backend Security
SECRET_KEY=b07808f907d6a532da2179487c6a43f5235e18c822eb629e7c75485df311a429
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Backend Runtime
LOG_LEVEL=INFO
STORAGE_PATH=./storage
MAX_DOCUMENT_SIZE_MB=50
MAX_VIDEO_SIZE_MB=500

# Frontend Local Development
# Put this in apps/frontend/.env.local when running npm run dev locally.
NEXT_PUBLIC_API_URL=http://localhost:8000

# LLM / Chatbot Configuration
LLM_PROVIDER=google
LLM_MODEL=gemini-3.1-flash-lite
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=512
LLM_REQUEST_TIMEOUT_SECONDS=180

# LLM_THINKING_LEVEL applies to Gemini models that support thinking config.
# Leave empty when using a model that does not support thinking config.
# LLM_THINKING_LEVEL=low

GOOGLE_AI_API_KEY=your_google_ai_studio_key
GOOGLE_AI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
