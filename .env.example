# Database Configuration
DB_USER=lms_user
DB_PASSWORD=lms_password
DB_NAME=lms_db
DB_PORT=5432

# Backend Configuration
BACKEND_PORT=8000
SECRET_KEY=your-secret-key-change-in-production-min-32-chars

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://4.193.190.105

# JWT Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage
STORAGE_PATH=./storage

# LLM / Chatbot Configuration
LLM_PROVIDER=google
LLM_MODEL=gemini-3.1-flash-lite-preview
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=512
# LLM_THINKING_LEVEL applies to Gemini models only
# - gemini-3.1-flash-lite-preview
# - gemini-3.1-flash-lite
# - gemini-2.5-flash-lite
# - gemini-2.5-flash
# Leave empty when using a model that does not support thinking config
# LLM_THINKING_LEVEL=low
GOOGLE_AI_API_KEY=your_google_ai_studio_key
GOOGLE_AI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
